DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

DB_NAME=npd_tracker_v2
DB_USER=npd_tracker_v2
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Google Sheets one-way mirror sync (wired up in a later phase)
NPD_SHEETS_KEYFILE=secrets/service-account.json
NPD_SHEET_ID=
NPD_SHEET_TAB=NPD

# Google Drive photo storage — active once `manage.py drive_authorize` has
# written the token file. Client secrets = an OAuth "Desktop app" client
# downloaded from Google Cloud Console.
NPD_DRIVE_CLIENT_SECRETS=secrets/drive-oauth-client.json
NPD_DRIVE_TOKEN_FILE=secrets/drive-token.json
NPD_DRIVE_ROOT_FOLDER=NPD Tracker Photos
NPD_DRIVE_SYNC_SECONDS=120

# Google Sign-In (shared login)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAIL=shared-account@gmail.com
